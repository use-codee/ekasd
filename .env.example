# Optional. Copy to .env at the repository root; run the backend from that root.
WIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
WIND_LOG_LEVEL=INFO
# Optional override: ASCII HH:MM, applied on each delivery day's D-1 date.
WIND_DEFAULT_CUTOFF=09:30
# Optional absolute directory; omit to resolve data/processed relative to source.
# WIND_PROCESSED_DIR=/absolute/path/to/project/data/processed

# Docker Compose: only WIND_DEFAULT_CUTOFF and WIND_LOG_LEVEL above are forwarded.
# Container data path and PORT are fixed by Compose; host WIND_PROCESSED_DIR is ignored.
# Container proxy is same-origin, so Compose uses WIND_CORS_ORIGINS=[].
# Standalone backend image: PORT may be overridden at docker run (default 8000).
